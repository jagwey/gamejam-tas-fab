[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/protocol_theme.tres" id="theme"]
[sub_resource type="GDScript" id="code"]
script/source = "extends Control\nsignal closed\nfunc _ready() -> void:\n\tvar path: String = \"res://assets/portraits/poster_key_art.jpg\"\n\tif ResourceLoader.exists(path):\n\t\t%Art.texture = load(path)\n\t%Back.pressed.connect(_close)\n\tvisibility_changed.connect(_on_visibility_changed)\n\nfunc _on_visibility_changed() -> void:\n\tif is_visible_in_tree():\n\t\t%Back.grab_focus()\n\nfunc _unhandled_input(event: InputEvent) -> void:\n\tif is_visible_in_tree() and event.is_action_pressed(\"pause\"):\n\t\tget_viewport().set_input_as_handled()\n\t\t_close()\n\nfunc _close() -> void:\n\thide()\n\tclosed.emit()\n"

