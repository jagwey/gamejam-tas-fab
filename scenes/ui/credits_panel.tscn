[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/protocol_theme.tres" id="theme"]
[sub_resource type="GDScript" id="code"]
script/source = "extends Control\nsignal closed\nfunc _ready() -> void:\n\t%Back.pressed.connect(_close)\n\tvisibility_changed.connect(_on_visibility_changed)\n\nfunc _on_visibility_changed() -> void:\n\tif is_visible_in_tree():\n\t\t%Back.grab_focus()\n\nfunc _unhandled_input(event: InputEvent) -> void:\n\tif is_visible_in_tree() and event.is_action_pressed(\"pause\"):\n\t\tget_viewport().set_input_as_handled()\n\t\t_close()\n\nfunc _close() -> void:\n\tAudioManager.play_sfx(\"sfx_puzzle_move\", -16.0)\n\thide()\n\tclosed.emit()\n"


[node name="CreditsPanel" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("theme")
script = SubResource("code")

[node name="Shade" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.029, 0.045, 0.064, 0.96)

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="CreditsCard" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(590, 0)

[node name="Inset" type="MarginContainer" parent="Center/CreditsCard"]
theme_override_constants/margin_left = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_bottom = 14

[node name="Body" type="VBoxContainer" parent="Center/CreditsCard/Inset"]
