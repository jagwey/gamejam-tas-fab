[sub_resource type="Shader" id="edge_shader"]
code = "shader_type canvas_item; uniform vec2 incoming = vec2(0.0); uniform float strength = 0.0; void fragment(){ vec2 p = (UV - 0.5) * 2.0; float rim = smoothstep(0.56, 1.0, max(abs(p.x), abs(p.y))); float facing = dot(p, incoming); COLOR = vec4(0.97, 0.12, 0.22, rim * strength * clamp(0.48 + facing, 0.08, 1.0)); }"
[sub_resource type="ShaderMaterial" id="edge_material"]
resource_local_to_scene = true
shader = SubResource("edge_shader")

