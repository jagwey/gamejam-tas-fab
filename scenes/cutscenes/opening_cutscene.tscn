[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/protocol_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/systems/cutscene_player.gd" id="script"]
[sub_resource type="Shader" id="rain"]
code = "shader_type canvas_item;
float rand(float n){return fract(sin(n * 91.73) * 4375.51);}
void fragment(){
 vec2 p = UV * vec2(76., 5.); p.x += UV.y * 10.;
 float column = floor(p.x);
 float phase = fract(p.y - TIME * (1.8 + rand(column)) + rand(column+11.));
 float streak = (1. - smoothstep(0.02,0.11,abs(fract(p.x)-0.5))) * smoothstep(0.72,1.,phase);
 COLOR = vec4(0.62,0.78,0.86,streak*0.38);
}"
[sub_resource type="ShaderMaterial" id="rain_mat"]
