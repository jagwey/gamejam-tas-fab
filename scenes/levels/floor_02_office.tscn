[node name="ArchiveLoreTerminal" parent="Interactables" instance=ExtResource("12_lore_terminal")]
position = Vector3(14.5, 0, -21)
rotation_degrees = Vector3(0, -90, 0)
terminal_title = "Çalınan BETA Araştırması"
terminal_body = "ARŞİV KAYDI — BETA ARAŞTIRMA DOSYASI #0417\n\nGeneral'in laboratuvarından çalınan BETA araştırmasının tüm kopyaları bu sunuculardan Volkov'un özel ağına aktarıldı. BETA Cihazı'nın biyolojik enerji dönüşüm verisi şifresiz.\n\nKat 5'teki Beta Reaktörü savunma ağı Kat 3 ve 4'teki röle istasyonlarından besleniyor. Röleler düşerse reaktör kalkanı devre dışı kalır.\n\nVolkov'a not: Ajan Aydın binada. Lobi hattı rapor vermiyor."

