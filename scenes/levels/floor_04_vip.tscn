[node name="VipLoreTerminal" parent="Interactables" instance=ExtResource("7_lore_terminal")]
position = Vector3(-23, 0, -18.6)
rotation_degrees = Vector3(0, 180, 0)
terminal_title = "Volkov'un Tahliye Emri"
terminal_body = "GİZLİ EMİR — V. VOLKOV / ÇATI TAHLİYE PROTOKOLÜ\n\nTüm birimlere: Beta Reaktörü çekirdeği çatıda tam güce ulaştı. Tahliye helikopteri çevrim tamamlandığında çatıya inecek. Çekirdek modül ve rejenerasyon serumu benimle birlikte binayı terk edecek.\n\nDeneysel Savunma Kulesi aktive edilecek. Kule, reaktörden beslenen kalkan ağıyla çatıyı kuşatır; yetkisiz her hedefi otomatik olarak vurur. Kapatma yalnızca reaktör tabanındaki konsoldan mümkün.\n\nAjan Aydın bu kata ulaşırsa komandolar kasayı mühürleyecek. Sıra kilidi kodu değiştirildi. Kimse çatıya çıkmayacak.\n\n— V."

