position = Vector3(24.5, 0, -14.75)
rotation_degrees = Vector3(0, 180, 0)
terminal_title = "Volkov Raporu — Beta Reaktörü"
terminal_body = "OPERASYON KAYDI — GÜVENLİK ŞEFLİĞİ\n\nViktor Volkov'un ekibi binayı 03:40'ta devraldı. General'in BETA araştırma dosyaları ve Beta Reaktörü'nün çekirdek modülü 5. kata taşındı.\n\nTalimat: Lobi hattı kilitli kalacak. Asansör güvenlik kilidi yalnızca hizalama terminalinden açılabilir. İzinsiz giriş yapan herkes etkisiz hale getirilecek.\n\nNot: Reaktör çevriminin tamamlanmasına 6 saat var. Volkov, sızıntıyı engellemek için tüm iletişimi kesti. Dışarıdan yardım gelmeyecek."

